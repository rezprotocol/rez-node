# Copy to .env and edit before `docker compose up`.
PG_USER=rez
PG_PASSWORD=change-me-in-production
PG_DB=rez
# Redis is trusted-cluster-internal; still require a password (compose fails if unset).
REDIS_PASSWORD=change-me-in-production-too
# At-rest storage encryption key — SHARED by every node in this home cluster so
# they can read each other's encrypted rows. 32 raw bytes, base64. Generate with:
#   openssl rand -base64 32
# SECRET: keep it in a secret manager, never commit a real value.
REZ_STORAGE_ENCRYPTION_KEY=replace-with-`openssl rand -base64 32`
LB_PORT=8443
# DNS-pinned hostname clients use; nodes advertise this to the WAN.
ADVERTISED_HOST=your.cluster.example
