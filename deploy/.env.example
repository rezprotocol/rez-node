# Copy to .env and edit before `docker compose up`.
PG_USER=rez
PG_PASSWORD=change-me-in-production
PG_DB=rez
# Redis is trusted-cluster-internal; still require a password (compose fails if unset).
REDIS_PASSWORD=change-me-in-production-too
# At-rest storage encryption key — SHARED by every node in this home cluster so
# they can read each other's encrypted rows. 32 raw bytes, base64. Generate with:
#   openssl rand -base64 32
# SECRET: keep it in a secret manager, never commit a real value.
# Left BLANK on purpose: compose's ${REZ_STORAGE_ENCRYPTION_KEY:?...} fails fast
# if you forget to set it, rather than booting with a bogus placeholder.
REZ_STORAGE_ENCRYPTION_KEY=
LB_PORT=8443
# DNS-pinned hostname clients use; nodes advertise this to the WAN.
ADVERTISED_HOST=your.cluster.example
NODE1_RELAY_PORT=4201
NODE2_RELAY_PORT=4202
# Public deployments fail startup when this set is empty. Each entry is an authenticated Rez
# bootstrap relay; use the currently published neutral seed set for the target network.
REZ_REQUIRE_KNOWN_RELAYS=1
REZ_KNOWN_RELAYS_JSON=[{"id":"relay:replace-with-published-seed-id","host":"seed.rez.example","port":4201,"tls":true}]
# TLS is mandatory on the public listener. Absolute paths are simplest with Docker Compose.
TLS_CERT_PATH=/etc/letsencrypt/live/your.cluster.example/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/your.cluster.example/privkey.pem
